# Required: Groq API key for the LLM analysis step.
# Create one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google PageSpeed Insights key. Without it the API still works but is
# rate limited; a key raises the quota from 400 to 25,000 requests/day.
# https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com
PAGESPEED_API_KEY=
